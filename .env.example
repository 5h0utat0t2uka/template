# 平文の `.env` および `.env.*`（`.env.*.enc` を除く）はコミットしないこと。
# 実値を入れたファイルは `sops -e -i .env.production` のように暗号化し、
# `.env.*.enc` のみをリポジトリに含めること。
#
# 復号: sops -d .env.production.enc > .env.production
# 編集: sops .env.production.enc
# 暗号: sops -e -i .env.production    # 拡張子は .sops.yaml の path_regex に合わせる

# 例: API のベース URL（ビルド時にクライアントへ露出する値）
VITE_API_BASE_URL=https://api.example.com

# 例: サーバーサイドでのみ参照するシークレット
API_SECRET_KEY=replace-me

