{
  "name": "template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
